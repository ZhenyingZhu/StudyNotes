# Copy this file to .env before starting the development environment.

DOTNET_SDK_VERSION=10.0.100
DOTNET_EF_VERSION=10.0.1
NODE_VERSION=22.16.0
PNPM_VERSION=10.11.0
AZURE_CLI_VERSION=2.78.0
BICEP_VERSION=v0.37.4

POSTGRES_IMAGE=postgres:18.0-bookworm
AZURITE_IMAGE=mcr.microsoft.com/azure-storage/azurite:3.35.0

POSTGRES_USER=itemorganizer
POSTGRES_PASSWORD=ChangeThis_ForLocalDevOnly_123!
POSTGRES_DATABASE=itemorganizer

ASPNETCORE_ENVIRONMENT=Development

ITEMORGANIZER_DATABASE_CONNECTION=Host=postgres;Port=5432;Database=itemorganizer;Username=itemorganizer;Password=ChangeThis_ForLocalDevOnly_123!
ITEMORGANIZER_STORAGE_CONNECTION=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1;
PhotoStorage__ContainerName=photos
PhotoStorage__ReadUrlMinutes=5
PhotoStorage__MaximumPhotosPerOwner=1000
PhotoStorage__CleanupEnabled=true
PhotoStorage__CleanupIntervalMinutes=5
Analysis__WorkerEnabled=true
Analysis__PollingSeconds=2
Analysis__QueueName=item-organizer-analyses
Analysis__DeadLetterQueueName=item-organizer-analyses-deadletter
Analysis__PromptVersion=2026-09-15.m1
Analysis__SchemaVersion=item-organizer.analysis-result.v1
Analysis__Model=deterministic-mock

# Approved internal npm-compatible registry. Override locally only with another
# organization-approved registry; there is intentionally no public fallback.
ITEMORGANIZER_NPM_REGISTRY=https://pkgs.dev.azure.com/msazure/one/_packaging/one_PublicPackages/npm/registry/
